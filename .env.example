# LLM Configuration (Groq or OpenAI)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional OpenAI Fallback / Embeddings
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone Vector Store Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=industry-agentic-rag-kb
PINECONE_NAMESPACE=langgraph-agentic-rag

# Embedding Model Configuration
# Options: sentence-transformers/all-MiniLM-L6-v2 (local HuggingFace, free) or text-embedding-3-small
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Tavily Web Search API Key
TAVILY_API_KEY=your_tavily_api_key_here

# App Security & Settings
ADMIN_API_KEY=change_this_admin_key
PORT=8000
HOST=0.0.0.0

# LangSmith Tracing (Optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=HR_Agent
